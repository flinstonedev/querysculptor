{
  "name": "querysculptor",
  "version": "0.1.0",
  "description": "⚒️ QuerySculptor - Craft GraphQL queries with AI agents using MCP tools. Reliable session management and comprehensive agent testing.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsx api/server.ts",
    "dev": "tsx --watch api/server.ts",
    "test": "NODE_ENV=test vitest",
    "test:watch": "NODE_ENV=test vitest --watch",
    "test:ui": "NODE_ENV=test vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:agent": "USE_REAL_REDIS=true vitest tests/agent-testing/",
    "test:agent:basic": "USE_REAL_REDIS=true vitest tests/agent-testing/agent-inline-fragment-fix.test.ts",
    "test:agent:debug": "USE_REAL_REDIS=true vitest tests/agent-testing/ --reporter=verbose",
    "test:agent:errors": "USE_REAL_REDIS=true vitest tests/agent-testing/error-scenario-tests.test.ts"
  },
  "keywords": [
    "graphql",
    "mcp",
    "query-builder",
    "agent"
  ],
  "author": "flinstonedev",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flinstonedev/querysculptor.git"
  },
  "bugs": {
    "url": "https://github.com/flinstonedev/querysculptor/issues"
  },
  "homepage": "https://github.com/flinstonedev/querysculptor#readme",
  "packageManager": "pnpm@9.4.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@vercel/mcp-adapter": "^1.0.0",
    "dotenv": "^16.5.0",
    "graphql": "^16.12.0",
    "redis": "^5.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "zod-to-json-schema": "^3.25.1"
  },
  "pnpm": {
    "overrides": {
      "next": "15.3.8",
      "qs": ">=6.14.1",
      "vite": ">=6.3.6",
      "body-parser": ">=2.2.1"
    }
  }
}