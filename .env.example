# ============================================================================
# QuerySculptor MCP Server - Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Redis Configuration (Required for session management)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Session TTL in seconds (0 = no expiry)
SESSION_TTL_SECONDS=3600

# Redis connection timeouts (milliseconds)
REDIS_CONNECT_TIMEOUT_MS=100000
REDIS_RETRY_INTERVAL_MS=30000
REDIS_OPERATION_RETRY_MS=1000
REDIS_READY_MAX_WAIT_MS=100000
REDIS_OPERATION_MAX_ATTEMPTS=10

# ----------------------------------------------------------------------------
# GraphQL Endpoint Configuration (Optional - can be provided per-request)
# ----------------------------------------------------------------------------

# Default GraphQL endpoint (fallback if not provided in tool calls)
# DEFAULT_GRAPHQL_ENDPOINT=https://api.example.com/graphql

# Default GraphQL headers as JSON object (fallback if not provided in tool calls)
# Example: DEFAULT_GRAPHQL_HEADERS={"X-API-Key": "your-key"}
# DEFAULT_GRAPHQL_HEADERS=

# IMPORTANT: For security, use transient credentials (graphql_endpoint and bearer_token)
# provided with each tool call instead of storing them here. This ensures credentials
# are never persisted on the server.

# ----------------------------------------------------------------------------
# Security Settings - Endpoint Validation
# ----------------------------------------------------------------------------

# Require HTTPS for endpoints in production (default: true)
# Set to false only for development/testing
REQUIRE_HTTPS=true

# Allow localhost endpoints (default: false in production, true in dev/test)
# ALLOW_LOCALHOST_ENDPOINTS=false

# Allowed ports for GraphQL endpoints (comma-separated)
# Leave empty to allow standard ports (80, 443, 8080, 4000)
# ALLOWED_ENDPOINT_PORTS=443,80,8080,4000

# Maximum number of different endpoints per client (prevents proxy abuse)
# Default: 10 endpoints per hour
MAX_ENDPOINTS_PER_CLIENT=10

# ----------------------------------------------------------------------------
# Security Settings - Operation Restrictions
# ----------------------------------------------------------------------------

# Allow GraphQL subscriptions (default: false - prevents real-time proxy abuse)
ALLOW_SUBSCRIPTIONS=false

# Require operation names for non-introspection queries (for audit logging)
# Default: false
# REQUIRE_OPERATION_NAMES=false

# ----------------------------------------------------------------------------
# Security Settings - Rate Limiting & Resource Protection
# ----------------------------------------------------------------------------

# Maximum response size in MB (prevents data exfiltration)
# Default: 1MB
MAX_RESPONSE_SIZE_MB=1

# Maximum executions per minute per session
# Default: 10
# MAX_EXECUTIONS_PER_MINUTE=10

# Maximum bandwidth per session per hour (in MB)
# Default: 10MB
# MAX_BANDWIDTH_PER_SESSION_MB=10

# ----------------------------------------------------------------------------
# Environment (auto-detected, can be overridden)
# ----------------------------------------------------------------------------

# Set to 'production', 'development', or 'test'
# NODE_ENV=production
